# Copy this file to .streamlit/secrets.toml (on your computer) and fill in every value.
# On Streamlit Community Cloud, paste the same lines into: your app > Settings > Secrets.
# Never commit secrets.toml: it's listed in .gitignore.

APP_TITLE = "The Shamp House"
APP_TZ = "America/New_York"

# --- Supabase: Project Settings > API (URL and keys) ---
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_..."
SUPABASE_SECRET_KEY = "sb_secret_..."

# --- Supabase database: Connect > Session pooler (same values as the R app's .Renviron) ---
PG_HOST = "aws-0-us-east-1.pooler.supabase.com"
PG_PORT = "5432"
PG_DB = "postgres"
PG_USER = "postgres.YOUR-PROJECT-REF"
PG_PASSWORD = "your-database-password"
PG_SSLMODE = "require"

# --- Logins that are admins (comma-separated) ---
ADMIN_EMAILS = "dad@shamp.com,mom@shamp.com"

# --- AI (console.groq.com > API Keys) ---
GROQ_API_KEY = "gsk_..."
GROQ_MODEL = "openai/gpt-oss-120b"

# --- Verse of the day: kjv = King James Version (others: web, asv, bbe) ---
BIBLE_TRANSLATION = "kjv"

# --- Weather location (Mandarin, Jacksonville) ---
WEATHER_LAT = "30.159"
WEATHER_LON = "-81.628"

# --- School run traffic on Today (developer.tomtom.com > API Keys) ---
TOMTOM_API_KEY = "your-tomtom-key"

# --- NASA space photo of the day (optional; free key at api.nasa.gov, otherwise a shared demo key is used) ---
NASA_API_KEY = ""
